{
    <div class="footer">
        <div class="footer-text">Elevate Your Learning with Pluggat.se</div>
        <div class="footer-contact">
            Contact: <a href="mailto:edvin.thornholm@gmail.com" class="text-white">edvin.thornholm@gmail.com</a>
        </div>
    </div>
