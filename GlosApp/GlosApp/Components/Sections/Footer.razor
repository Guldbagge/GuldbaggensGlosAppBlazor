@inject NavigationManager NavManager

<div class="main-content">
    @ChildContent
</div>

@if (!NavManager.Uri.Contains("/my-own-words") && !NavManager.Uri.Contains("/user/words"))
{
    <div class="footer">
        <div class="footer-text">Elevate Your Learning with Pluggat.se</div>
        <div class="footer-logo">
            <a href="/">
                <img src="/images/logo.jpg" alt="Home" />
            </a>
        </div>
        <div class="footer-contact">Contact: edvin.thornholm@gmail.com</div>
    </div>



}

@code {
    [Parameter]
    public RenderFragment ChildContent { get; set; }
}
