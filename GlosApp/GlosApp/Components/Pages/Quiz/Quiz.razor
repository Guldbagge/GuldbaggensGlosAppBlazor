@page "/quiz"
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@rendermode InteractiveServer
@inject IJSRuntime JSRuntime



<main class="wrapper d-flex flex-column min-vh-100">

    <div class="container text-center">
        <h2>Välkommen till Quiz-sidan</h2>
        <p>Välj ett quiz eller skapa ett eget för att testa dina kunskaper</p>

        <div class="d-flex justify-content-center mt-4">
            <div class="btn mt-4">
                <NavLink href="ai-quiz" class="btn large-btn">Skapa Quiz med AI</NavLink>
                @* <NavLink href="quiz-reading" class="btn large-btn">Träna Läsförståelse</NavLink> *@
@*                 <NavLink href="quiz-economy" class="btn btn-primary">Ekonomi</NavLink>
                <NavLink href="quiz-body" class="btn btn-primary">Kroppen</NavLink> *@
               
            </div>
        </div>
    </div>

</main>


@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("scrollToTop");
        }
    }
}



