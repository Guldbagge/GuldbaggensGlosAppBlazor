<div class="beta-banner">
    🚀 Denna version är en **beta**! Funktionalitet och innehåll kan ändras. Tack för att du testar! 😊
</div>


@page "/ai-quiz"
@using GlosApp.Models
@inject ILogger<Ai> Logger
@rendermode InteractiveServer
@inject IConfiguration Configuration


<h2 class="text-center my-4">🤖 AI Quiz Generator</h2>

<div class="robot-avatar">
    <img src="https://cdn-icons-png.flaticon.com/512/4712/4712105.png" alt="AI Bot" />
</div>

<div class="chat-container">
    <div class="robot-container">
        <p class="robot-text">Hej! Välj ett ämne för att skapa ett quiz med 10 frågor. 😊</p>
    </div>

    <div class="chat-box d-none">
        <AiResponse @ref="aiComponent" UserMessage="@userMessage" ApiToken="@apiToken" OnResponseReceived="HandleResponse" />
    </div>

    <div class="input-group mt-3">
        <input type="text" class="form-control" @bind="userMessage" placeholder="Ex. Historia, Geografi, Matematik..." />
        <button class="btn btn-primary ms-2 px-4" @onclick="GetAIQuiz" disabled="@isLoading">
            @(isLoading ? "Väntar..." : "Skapa")
        </button>
    </div>

    @if (quizQuestions.Any())
    {
        <div class="quiz-container mt-4">
            @foreach (var question in quizQuestions)
            {
                <div class="quiz-question mb-3 p-3 border rounded">
                    <p><strong>@question.QuestionText</strong></p>
                    <div class="d-flex flex-column">
                        @foreach (var option in question.Options)
                        {
                            <button class="btn @(question.SelectedAnswer == option
                                             ? (option == question.CorrectAnswer ? "btn-success" : "btn-danger wrong-answer")
                                             : "btn-outline-primary")"
                                    style="margin-bottom: 5px;"
                                    @onclick="() => CheckAnswer(question, option)"
                                    disabled="@quizCompleted">
                                @option
                            </button>
                        }

                        @if (question.ShowCorrectAnswer)
                        {
                            <p class="mt-2 correct-answer show">✅ Rätt svar: @question.CorrectAnswer</p>
                        }

                    </div>
                </div>
            }
        </div>
    }

    @if (quizCompleted)
    {
        <div class="quiz-result text-center mt-4 p-3 border rounded">
            <h3>🎉 Quiz avslutat!</h3>
            <p>Du fick <strong>@GetCorrectAnswersCount()</strong> av <strong>@quizQuestions.Count</strong> rätt! ✅</p>
            <button class="btn btn-primary mt-2" @onclick="RestartQuiz">Starta om</button>
        </div>
    }

    <div class="year-selection text-center my-3">
        <p class="fw-bold">Välj årskurs:</p>
        <div class="row justify-content-center">
            @foreach (int grade in Enumerable.Range(4, 6)) // Skapar knappar för årskurs 4-9
            {
                <div class="col-4 d-flex justify-content-center mb-2">
                    <button class="btn @(selectedGrade == grade ? "btn-secondary" : "btn-outline-secondary") w-100"
                            @onclick="() => SelectGrade(grade)">
                        Årskurs @grade
                    </button>
                </div>
            }
        </div>
        <p class="text-center mt-2">Vald årskurs: <strong>@selectedGrade</strong></p>
    </div>

</div>

<div class="container mt-5 p-4 border rounded shadow bg-white">
    <h3 class="text-center mb-3">📝 Skapa ett roligt och lärorikt quiz!</h3>
    <p>Här är fem exempel på prompts du kan använda för att generera quizfrågor:</p>
    <ul>
        <li><strong>🧮 Matematik:</strong> "Bråktal för årskurs 6. Använd flervalsfrågor med tydliga svarsalternativ."</li>
        <li><strong>🌍 Geografi:</strong> "Europas länder och huvudstäder. Varje fråga ska ha fyra alternativ, där ett är rätt."</li>
        <li><strong>🔬 Naturvetenskap:</strong> "Fotosyntesen. Frågorna ska vara anpassade för högstadieelever."</li>
        <li><strong>📜 Historia:</strong> "Industriella revolutionen."</li>
        <li><strong>⚽ Fritidsintresse:</strong> "Fotbollsregler och historiska händelser inom sporten. Frågorna ska passa både nybörjare och fotbollsfans."</li>
    </ul>
    <p>Testa en prompt och skapa ditt eget quiz! 🎯</p>
</div>


@code {
    private bool isLoading = false;
    private string userMessage = "";
    private string apiToken = "";
    private AiResponse? aiComponent;
    private bool quizCompleted = false;
    private int selectedGrade = 5;
    
    private List<QuizQuestionModel> quizQuestions = new List<QuizQuestionModel>();

    [Inject] private IJSRuntime jsRuntime { get; set; } = default!;
    

    private string GetApiToken()
    {
        return Configuration["ApiKeys:ServiceA"] ?? "API-nyckel saknas";
    }

    protected override void OnAfterRender(bool firstRender)
    {
        apiToken = GetApiToken(); 

        if (firstRender)
        {
            ScrollToTop();
        }
    }

    private void SelectGrade(int grade)
    {
        selectedGrade = grade;
        Logger.LogInformation($"Vald årskurs: {selectedGrade}"); // Loggar i backend
        StateHasChanged(); // Uppdatera UI:t
    }


    private async Task GetAIQuiz()
    {
        if (aiComponent is not null)
        {
            isLoading = true;
            StateHasChanged();

            // string prompt = $"Generera 10 quizfrågor om ämnet: {userMessage}. Format: Fråga | Alternativ1, Alternativ2, Alternativ3, Alternativ4 | Rätt svar";


            string prompt = $"Generera exakt 10 quizfrågor om ämnet: {userMessage}. " +
                $"Frågorna ska vara anpassade för elever i årskurs {selectedGrade}. " +
                "Varje fråga måste ha exakt 4 svarsalternativ. Inga fler, inga färre.\n\n" +
                "Svara i följande format, separerat med '|':\n\n" +
                "Fråga | Alternativ1, Alternativ2, Alternativ3, Alternativ4 | Rätt svar\n\n" +
                "Exempel:\n" +
                "Vad är huvudstaden i Sverige? | Stockholm, Oslo, Köpenhamn, Helsingfors | Stockholm\n\n" +
                "Viktigt: Endast 4 svarsalternativ per fråga. Undvik att lägga till fler eller färre. " +
                "Frågorna ska vara tydliga, relevanta och pedagogiska.";




            aiComponent.UserMessage = prompt;
            aiComponent.ApiToken = apiToken;
            await aiComponent.GetAIResponse();

            userMessage = "";
            isLoading = false;
            StateHasChanged();
        }
        else
        {
            Logger.LogError("🚨 aiComponent är null!");
        }
    }

    private void HandleResponse(string response)
    {
        Logger.LogInformation($"AI-svar mottaget: {response}");

        quizQuestions = response.Split('\n')
                                .Where(q => !string.IsNullOrWhiteSpace(q))
                                .Select(ParseQuizQuestion)
                                .Where(q => q != null)
                                .Cast<QuizQuestionModel>()
                                .ToList();

        StateHasChanged();
    }

    private QuizQuestionModel? ParseQuizQuestion(string line)
    {
        var parts = line.Split('|');
        if (parts.Length != 3) return null;

        var questionText = parts[0].Trim();
        var options = parts[1].Split(',').Select(o => o.Trim()).ToList();
        var correctAnswer = parts[2].Trim();

        return new QuizQuestionModel
        {
            QuestionText = questionText,
            Options = options,
            CorrectAnswer = correctAnswer
        };
    }

    private async Task CheckAnswer(QuizQuestionModel question, string selectedOption)
    {
        if (question.SelectedAnswer != null) return; // Förhindra att man ändrar svar

        question.SelectedAnswer = selectedOption;

        // Visa rätt svar endast om användaren svarade fel
        question.ShowCorrectAnswer = selectedOption != question.CorrectAnswer;

        StateHasChanged();

       
        await Task.Delay(500);

        if (quizQuestions.All(q => q.SelectedAnswer != null))
        {
            ConfirmQuizCompletion();
        }

        StateHasChanged();
    }


    private void ScrollToTop()
    {
        jsRuntime.InvokeVoidAsync("window.scrollTo", 0, 0);
    }

    private int GetCorrectAnswersCount()
    {
        return quizQuestions.Count(q => q.SelectedAnswer == q.CorrectAnswer);
    }
    private void ConfirmQuizCompletion()
    {
        quizCompleted = true;
        StateHasChanged();
    }

    private void RestartQuiz()
    {
        quizQuestions.Clear();
        quizCompleted = false;
        StateHasChanged();
    }

}

<style>
    .correct-answer {
        background-color: #28a745 !important; /* Grön */
        color: white;
        transition: opacity 0.8s ease-in-out;
        opacity: 0;
    }

    .show {
        opacity: 1;
    }

    .wrong-answer {
        background-color: #dc3545 !important; /* Röd */
        color: white;
    }

</style>

