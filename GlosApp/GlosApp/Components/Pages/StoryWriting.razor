@code {
    private StoryFormModel storyForm = new StoryFormModel();
    private string AiFeedback = string.Empty;
    private AiResponse? aiComponent;
    private string userMessage = "";
    private string apiToken = "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"; // Lägg till din riktiga API-nyckel

    private async Task AnalyzeText()
    {
        Console.WriteLine($"User story: {storyForm.UserStory}");  // Kontrollera att textfältet har värde
        Console.WriteLine($"User message: {userMessage}");

        if (string.IsNullOrWhiteSpace(storyForm.UserStory))
        {
            AiFeedback = "Skriv något i textfältet för att få feedback!";
            Console.WriteLine("Feedback: " + AiFeedback);
            StateHasChanged();
            return;
        }

        userMessage = $"Ge feedback på följande berättelse, anpassad för en elev i årskurs 7 svaret ska max vara 100 tecken.:\n\n{storyForm.UserStory}";

        await GetAIResponse();
        Console.WriteLine("Feedback efter respons: " + AiFeedback);
    }



    private async Task GetAIResponse()
    {
        if (aiComponent is null)
        {
            AiFeedback = "AI-komponenten är inte laddad än!";
            StateHasChanged();
            return;
        }

        await aiComponent.GetAIResponse();
        StateHasChanged();
    }


    private void HandleResponse(string response)
    {
        AiFeedback = response;
        StateHasChanged(); // Uppdatera UI för att visa feedback från AI
    }

