@page "/glossary/english"
@rendermode InteractiveServer

@using System.Linq
@using GlosApp.Models
@inject ApplicationDbContext DbContext
@inject IConfiguration Configuration
@using System.Diagnostics;

<div class="container">
    <h3>Glosformulär Engelska</h3>

    <EditForm Model="userAnswerForm" OnValidSubmit="CheckAnswers" novalidate autocomplete="off">
        @foreach (var answer in userAnswerForm.Answers)
        {
            <div class="form-group mt-5">
                <div class="d-flex align-items-baselin justify-content-between mb-2">
                        <label class="mr-3  mt-2">@answer.Swedish</label>
                    <button type="button" class="btn btn-info ms-2" @onclick="() => ExplainWord(answer)">
                        Förklara ordet
                    </button>
                </div>

                <InputText @bind-Value="answer.UserAnswer" class="form-control" autocomplete="off" />


                @if (currentExplanationWord?.Swedish == answer.Swedish)
                {
                    <div>
                        <AiResponse @ref="aiComponent" UserMessage="@userMessage" ApiToken="@apiToken" OnResponseReceived="HandleResponse" />
                    </div>
                }

                @if (showResult)
                {
                    if (string.IsNullOrWhiteSpace(answer.UserAnswer))
                    {
                        <span class="text-warning">⚠️ Detta fält är tomt.</span>
                    }
                    else if (answer.UserAnswer.Equals(answer.English, StringComparison.OrdinalIgnoreCase))
                    {
                        <span class="text-success">✔️ Rätt!</span>
                    }
                    else
                    {
                        <span class="text-danger">❌ Fel, rätt svar är "@answer.English".</span>
                    }
                }
            </div>
        }

        @if (showResult)
        {
            <div class="alert alert-info">
                Du fick @correctAnswers av @userAnswerForm.Answers.Count ord rätt!
                <br />
                Responstiden var @responseTime ms.
            </div>
        }

        @if (missingAnswers)
        {
            <div class="alert alert-warning">
                Du måste fylla i alla fält innan du kan kontrollera dina svar.
            </div>
        }

        <div class="d-flex align-items-center justify-content-between mb-2">
            <button type="submit" class="btn btn-primary">Kontrollera</button>
            <button type="button" class="btn btn-success" @onclick="ResetForm">Rensa glosformuläret</button>
        </div>

    </EditForm>

</div>

@code {
    private UserAnswerForm userAnswerForm = new UserAnswerForm();
    private int correctAnswers = 0;
    private bool showResult = false;
    private bool missingAnswers = false;
    private AiResponse? aiComponent;
    private string userMessage = "";
    private string apiToken = ""; // Inte hårdkodad längre

    protected override void OnInitialized()
    {
        // Hämta API-nyckeln från konfigurationen
        apiToken = Configuration["ApiKeys:ServiceA"] ?? "API-nyckel saknas";

        userAnswerForm.Answers = new List<WordAnswer>
        {
            new WordAnswer("röra vid", "touch"),
            new WordAnswer("tänkta", "think"),
            new WordAnswer("grädda", "bake"),
            new WordAnswer("gräddade", "baked"),
            new WordAnswer("handikappad", "disabled"),
            new WordAnswer("mata", "feed"),
            new WordAnswer("kommer inte att", "won’t"),
            new WordAnswer("snäll", "gentle"),
            new WordAnswer("upp på", "onto"),
            new WordAnswer("grind", "gate"),
            new WordAnswer("beställa", "order"),
            new WordAnswer("bita", "bite")
        };
    }

    private async Task GetAIResponse()
    {
        if (aiComponent is not null)
        {
            await aiComponent.GetAIResponse();
        }
    }

    private WordAnswer? currentExplanationWord = null;

    private async Task ExplainWord(WordAnswer answer)
    {
        aiResponseMessage = ""; 
        userMessage = $"Sätt ordet i en mening {answer.Swedish}";

        currentExplanationWord = null;
        await Task.Delay(50);
        currentExplanationWord = answer;
        StateHasChanged();

        await GetAIResponse();
    }

    private string aiResponseMessage = "";

    private void HandleResponse(string response)
    {
        aiResponseMessage = response;
        StateHasChanged(); 
        Task.Delay(10).ContinueWith(_ => InvokeAsync(StateHasChanged)); 
    }

    private long responseTime = 0;

    private async Task CheckAnswers()
    {
        var stopwatch = Stopwatch.StartNew();

        missingAnswers = userAnswerForm.Answers.Any(answer => string.IsNullOrWhiteSpace(answer.UserAnswer));

        if (missingAnswers)
        {
            showResult = false;
            stopwatch.Stop();
            return;
        }

        correctAnswers = userAnswerForm.Answers.Count(answer =>
            answer.UserAnswer?.Trim().Equals(answer.English.Trim(), StringComparison.OrdinalIgnoreCase) == true);

        stopwatch.Stop();
        responseTime = stopwatch.ElapsedMilliseconds;

        foreach (var answer in userAnswerForm.Answers)
        {
            DbContext.WordAnswers.Add(new WordAnswer
                {
                    Swedish = answer.Swedish,
                    English = answer.English,
                    UserAnswer = answer.UserAnswer,
                    Language = "English"
                });
        }

        DbContext.SaveChanges();
        showResult = true;

      

        responseTime = stopwatch.ElapsedMilliseconds;

        Console.WriteLine($"Responstiden var {responseTime} ms.");

        StateHasChanged();
    }



    private void ResetForm()
    {
        foreach (var answer in userAnswerForm.Answers)
        {
            answer.UserAnswer = string.Empty;
        }

        correctAnswers = 0;
        showResult = false;
        missingAnswers = false;
    }

    public class UserAnswerForm
    {
        public List<WordAnswer> Answers { get; set; } = new List<WordAnswer>();
    }
}

