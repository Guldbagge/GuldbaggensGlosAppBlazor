@page "/glossary-stats"
@inject ApplicationDbContext DbContext
@inject IJSRuntime JS
@rendermode InteractiveServer

<main class="wrapper d-flex flex-column min-vh-100">
    <div class="container text-center">
        <h2>Statistik över gjorda glosor</h2>

        <canvas id="myChart" width="400" height="200"></canvas>

        <div class="pa-4">
            <h4>Statistik</h4>
            <p>Totalt antal svar: <strong>@totalAnswers</strong></p>
            <p>Rätt svar: <strong>@correctAnswers</strong></p>
            <p>Fel svar: <strong>@wrongAnswers</strong></p>
            <p>Rätt i %: <strong>@correctPercentage%</strong></p>
        </div>
    </div>
</main>

@code {
    private int totalAnswers;
    private int correctAnswers;
    private int wrongAnswers;
    private double correctPercentage;

    protected override void OnInitialized()
    {
        var wordAnswers = DbContext.WordAnswers.ToList();

        totalAnswers = wordAnswers.Count;
        correctAnswers = wordAnswers.Count(wa => wa.UserAnswer?.Trim().Equals(wa.English.Trim(), StringComparison.OrdinalIgnoreCase) == true);
        wrongAnswers = totalAnswers - correctAnswers;
        correctPercentage = totalAnswers > 0 ? (correctAnswers * 100.0 / totalAnswers) : 0;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Console.WriteLine("🔵 Första renderingen - Anropar RenderChart()");
            await RenderChart();
        }
    }

    private async Task RenderChart()
    {
        try
        {
            await JS.InvokeVoidAsync("renderChart", "myChart", new
            {
                labels = new[] { "Rätt", "Fel" },
                data = new[] { correctAnswers, wrongAnswers }
            });
            Console.WriteLine("🟢 Diagram renderat!");
        }
        catch (Exception ex)
        {
            Console.WriteLine("🔴 JS Interop Error: " + ex.Message);
        }
    }
}





