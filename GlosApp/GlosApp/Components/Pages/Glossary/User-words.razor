@page "/glossary/create"
@using GlosApp.Models
@inject ApplicationDbContext DbContext
@rendermode InteractiveServer

<div class="container min-vh-100 d-flex flex-column " style="margin-top: 70px;">
    <h3>Hantera Dina Egna Glosor</h3>

    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <h4 class="card-title">📖 Skapa Effektiva Glosor</h4>
            <p class="card-text">När du skapar glosor, tänk på följande:</p>
            <ul>
                <li><strong>Välj ett ämne:</strong> Fokusera på specifika teman, t.ex. resor, ekonomi eller anatomi.</li>
                <li><strong>Anpassa svårighetsgraden:</strong> Börja med enkla ord och öka svårigheten gradvis.</li>
                <li><strong>Använd sammanhang:</strong> Skriv exempelmeningar för att bättre förstå användningen.</li>
                <li><strong>Uttal och stavning:</strong> Tänk på att utala orden hög för att få ett bra utal.</li>
            </ul>
        </div>
    </div>

    <div class="mb-3">
        <button class="btn btn-primary" @onclick="ShowAddModal">Lägg till</button>
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Svenska</th>
                <th>Engelska</th>
                <th>Åtgärder</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var word in Words)
            {
                <tr>
                    <td>@word.Swedish</td>
                    <td>@word.English</td>
                    <td>
                        <button class="btn btn-warning btn-sm mt-2" @onclick="() => EditWord(word)">Redigera</button>
                        <button class="btn btn-danger btn-sm mt-2" @onclick="() => DeleteWord(word.Id)">Ta bort</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <EditForm Model="EditingWord" OnValidSubmit="SaveWord" novalidate>
        <div class="modal @(ShowModal ? "show d-block" : "d-none")">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5>@(IsEditMode ? "Redigera ord" : "Lägg till ord")</h5>
                        <button type="button" class="btn-close" @onclick="CloseModal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="form-group mb-3">
                            <label for="swedish">Svenska</label>
                            <InputText id="swedish" @bind-Value="EditingWord.Swedish" class="form-control" />
                        </div>
                        <div class="form-group mb-3">
                            <label for="english">Engelska</label>
                            <InputText id="english" @bind-Value="EditingWord.English" class="form-control" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal">Avbryt</button>
                        <button type="submit" class="btn btn-primary">Spara</button>
                    </div>
                </div>
            </div>
        </div>
    </EditForm>
</div>

@code {
    private List<WordAnswer> Words = new();
    private WordAnswer EditingWord = new();
    private bool ShowModal = false;
    private bool IsEditMode = false;
    private AiResponse? aiComponent;
    [Inject] private IJSRuntime jsRuntime { get; set; } = default!;

    protected override void OnInitialized()
    {
        LoadWords();
    }

    private void LoadWords()
    {
        Words = DbContext.WordAnswers.Where(w => w.Language == "Test").ToList();
    }
    private void ShowAddModal()
    {
        EditingWord = new WordAnswer
            {
                Language = "Test", // Standardvärde för Language
                UserAnswer = string.Empty // Standardvärde för UserAnswer
            };
        IsEditMode = false;
        ShowModal = true;
    }



    private void EditWord(WordAnswer word)
    {
        EditingWord = new WordAnswer
            {
                Id = word.Id,
                Swedish = word.Swedish,
                English = word.English,
                Language = "Test" // Hårdkoda språket  "Test"
            };
        IsEditMode = true;
        ShowModal = true;
    }


    private void SaveWord()
    {
        if (string.IsNullOrWhiteSpace(EditingWord.Swedish) || string.IsNullOrWhiteSpace(EditingWord.English))
        {
            // Handle validation or show an error message to user.
            return;
        }

        if (IsEditMode)
        {
            var existingWord = DbContext.WordAnswers.FirstOrDefault(w => w.Id == EditingWord.Id);
            if (existingWord != null)
            {
                existingWord.Swedish = EditingWord.Swedish;
                existingWord.English = EditingWord.English;
                existingWord.Language = EditingWord.Language;
                DbContext.WordAnswers.Update(existingWord);
            }
        }
        else
        {
            DbContext.WordAnswers.Add(EditingWord);
        }

        DbContext.SaveChanges();
        LoadWords();
        CloseModal();
    }

    private void DeleteWord(int id)
    {
        var word = DbContext.WordAnswers.FirstOrDefault(w => w.Id == id);
        if (word != null)
        {
            DbContext.WordAnswers.Remove(word);
            DbContext.SaveChanges();
            LoadWords();
        }
    }

    private void CloseModal()
    {
        ShowModal = false;
        EditingWord = new WordAnswer(); // Reset EditingWord after modal close
    }

    private void ScrollToTop()
    {
        jsRuntime.InvokeVoidAsync("window.scrollTo", 0, 0);
    }
}


