@page "/glossary"
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation




<main class="wrapper">

    <div class="container text-center">
        <h2>Välkommen att tränna glossor</h2>

        <p>Du kan tränna de lärarn lagt in eller skapa egna glosor</p>

        <div class="d-flex justify-content-center mt-4">
            <div class="btn-group">
                <NavLink href="/glossary/sofia" class="btn btn-primary m-3">Engelska</NavLink>
                <NavLink href="/glossary/alma" class="btn btn-primary m-3">Spanska</NavLink>
                <NavLink href="/glossary/create" class="btn btn-primary m-3">Skapa</NavLink>
                <NavLink href="/glossary/my-own" class="btn btn-primary m-3">Egna</NavLink>
            </div>
        </div>
    </div>

</main>

<style>
    .btn-spacing {
        margin-right: 10px;
    }

        .btn-spacing:last-child {
            margin-right: 0;
        }
</style>

