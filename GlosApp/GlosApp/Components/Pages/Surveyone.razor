@page "/surveyone"
@using GlosApp.Models
@inject ApplicationDbContext DbContext
@rendermode InteractiveServer

<div class="bg-gray-200 min-h-screen flex items-center justify-center">
    <div class="container mx-auto p-6 bg-white shadow-lg rounded-lg max-w-2xl">
        <h2 class="text-2xl font-bold text-center pt-4">Din upplevelse av pluggat.se ✨</h2>

        @if (showThankYouMessage)
        {
            <div class="mt-6 p-4 bg-green-100 border border-green-400 text-green-700 rounded-lg text-center">
                <p class="font-semibold">Tack för att du svarade på enkäten! 🎉🥳</p>
                <p>Din feedback hjälper oss att förbättra webbplatsen. 🙌</p>
                <NavLink href="/" class="btn large-btn">🏠 Hem</NavLink>
            </div>
        }
        else
        {
            <div class="form">
                <EditForm Model="@survey" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />

                    <div class="space-y-4 mt-4">
                        <div class="form-card">
                            <div>
                                <label class="font-semibold">🖥️ Hur ofta använder du webbplatsen?</label>
                            </div>
                            <div>
                                <InputRadioGroup @bind-Value="survey.UsageFrequency">
                                    @foreach (var option in usageFrequencyOptions)
                                    {
                                        <div>
                                            <InputRadio Value="@option" />
                                            <label>@option</label>
                                        </div>
                                    }
                                </InputRadioGroup>
                            </div>
                        </div>

                        <div class="form-card">
                            <div>
                                <label class="font-semibold">Vad tycker du om sättet att träna glosor? 🤔</label>
                            </div>
                            <div>
                                <InputRadioGroup @bind-Value="survey.VocabularyExperience">
                                    @foreach (var option in vocabularyExperienceOptions)
                                    {
                                        <div>
                                            <InputRadio Value="@option" />
                                            <label>@option</label>
                                        </div>
                                    }
                                </InputRadioGroup>
                            </div>
                        </div>

                        <div class="form-card">
                            <div>
                                <label class="font-semibold">Har du skapat ett AI-quiz? 🎯</label>
                            </div>
                            <div>
                                <InputRadioGroup @bind-Value="survey.AiQuizExperience">
                                    @foreach (var option in aiQuizExperienceOptions)
                                    {
                                        <div>
                                            <InputRadio Value="@option" />
                                            <label>@option</label>
                                        </div>
                                    }
                                </InputRadioGroup>
                            </div>
                        </div>

                        <div class="form-card">
                            <div>
                                <label class="font-semibold">Hur hjälpsam är AI-läraren? 🧠</label>
                            </div>
                            <div>
                                <InputRadioGroup @bind-Value="survey.AiTeacherFeedback">
                                    @foreach (var option in aiTeacherFeedbackOptions)
                                    {
                                        <div>
                                            <InputRadio Value="@option" />
                                            <label>@option</label>
                                        </div>
                                    }
                                </InputRadioGroup>
                            </div>
                        </div>

                        <div class="form-card">
                            <div>
                                <label class="font-semibold">Skulle du rekommendera webbplatsen? 👫</label>
                            </div>
                            <div>
                                <InputRadioGroup @bind-Value="survey.RecommendWebsite">
                                    @foreach (var option in recommendWebsiteOptions)
                                    {
                                        <div>
                                            <InputRadio Value="@option" />
                                            <label>@option</label>
                                        </div>
                                    }
                                </InputRadioGroup>
                            </div>
                        </div>

                        <div class="form-card">
                            <div>
                                <label class="font-semibold">Har du några förbättringsförslag? ✍️</label>
                            </div>
                            <div>
                                <InputTextArea @bind-Value="survey.SuggestedImprovements" class="w-full p-2 border rounded" rows="4" />
                            </div>
                        </div>
                    </div>
                    <button type="submit" class="w-full btn large-btn text-white py-2 rounded-lg hover:bg-blue-600">
                        🚀 Skicka in svar
                    </button>
                </EditForm>

            </div>
        }
    </div>
</div>

@code {
    private SurveyResponse survey = new SurveyResponse();
    private bool showThankYouMessage = false;

    private readonly List<string> usageFrequencyOptions = new() { "Varje dag 🏆", "Några gånger i veckan 📆", "Någon gång i månaden 🌙", "Aldrig ❌" };
    private readonly List<string> vocabularyExperienceOptions = new() { "Väldigt bra 😍", "Ganska bra 😊", "Sådär 😐", "Inte bra 😕" };
    private readonly List<string> aiQuizExperienceOptions = new() { "Ja, och jag tyckte det var roligt! 🎉", "Ja, men det var lite svårt 🤔", "Nej, men jag vill prova 👀", "Nej, jag är inte intresserad ❌" };
    private readonly List<string> aiTeacherFeedbackOptions = new() { "Väldigt hjälpsam 👍", "Ganska bra ✅", "Den hjälper lite, men inte alltid 🤷", "Jag förstår inte feedbacken ❓" };
    private readonly List<string> recommendWebsiteOptions = new() { "Ja, absolut! 🎯", "Kanske 🤔", "Nej ❌" };

    private async Task HandleSubmit()
    {
        DbContext.SurveyResponses.Add(survey);
        await DbContext.SaveChangesAsync();
        showThankYouMessage = true;
    }
}
