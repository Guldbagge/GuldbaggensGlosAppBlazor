@page "/ai"
@inject ILogger<Ai> Logger
@rendermode InteractiveServer

<h2 class="text-center my-4">🤖 AI Support</h2>

<div class="robot-avatar"><img src="https://cdn-icons-png.flaticon.com/512/4712/4712105.png" alt="AI Bot" /></div>
<div class="chat-container">
    <!-- Robot Avatar -->
    <div class="robot-container">
@*         <img src="robot.png" alt="AI Bot" class="robot-avatar" /> *@
       
        <p class="robot-text">Hej! Ställ en fråga så ska jag försöka hjälpa dig. 😊</p>
    </div>

    <div class="chat-box">
        <AiResponse @ref="aiComponent" UserMessage="@userMessage" ApiToken="@apiToken" OnResponseReceived="HandleResponse" />
    </div>

    <div class="input-group mt-3">
        <input type="text" class="form-control" @bind="userMessage" placeholder="Skriv din fråga här..." />
        <button class="btn btn-primary ms-2 px-4" @onclick="GetAIResponse" disabled="@isLoading">
            @(isLoading ? "Väntar..." : "Skicka fråga")
        </button>
    </div>
</div>

@code {
    private bool isLoading = false;
    private string userMessage = "";
    private string apiToken = "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";
    private AiResponse? aiComponent;
    [Inject] private IJSRuntime jsRuntime { get; set; } = default!;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            ScrollToTop();
        }
    }


    private async Task GetAIResponse()
    {
        if (aiComponent is not null)
        {
            isLoading = true;
            StateHasChanged();

            await aiComponent.GetAIResponse();

            // 🟢 Rensa fältet efter att frågan skickats
            userMessage = "";
            isLoading = false;
            StateHasChanged();
        }
        else
        {
            Logger.LogError("🚨 aiComponent är null!");
        }
    }

    private void HandleResponse(string response)
    {
        Logger.LogInformation($"AI-svar mottaget: {response}");
    }
    private void ScrollToTop()
    {
        jsRuntime.InvokeVoidAsync("window.scrollTo", 0, 0);
    }
}




