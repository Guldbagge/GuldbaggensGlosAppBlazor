@page "/ai"
@using System.Text.Json
@inject HttpClient Http
@inject ILogger<Ai> Logger
@rendermode InteractiveServer

<h3>AI Support</h3>

<button class="btn btn-primary" @onclick="GetAIResponse" disabled="@isLoading">
    @if (isLoading)
    {
        <span>Väntar på AI...</span>
    }
    else
    {
        <span>Få AI-svar</span>
    }
</button>

@if (!string.IsNullOrEmpty(aiResponse))
{
    <div class="alert alert-info mt-3">
        <strong>AI Svar:</strong> @aiResponse
    </div>
}

@code {
    private string aiResponse = string.Empty;
    private bool isLoading = false;
    private string userMessage = "write a haiku about ai";

    private async Task GetAIResponse()
    {
        Logger.LogInformation("🟢 GetAIResponse() anropad!");
        isLoading = true;
        StateHasChanged();

        try
        {
            Logger.LogInformation("🟡 Förbereder API-anrop...");
            var requestData = new
            {
                model = "gpt-4o-mini",
                store = true,
                messages = new[]
                {
                    new { role = "user", content = userMessage }
                }
            };

            var requestMessage = new HttpRequestMessage(HttpMethod.Post, "v1/chat/completions")
                {
                    Content = new StringContent(JsonSerializer.Serialize(requestData), Encoding.UTF8, "application/json")
                };

            requestMessage.Headers.Add("Authorization", "Bearer sk-proj-XXXXXXX");

            var response = await Http.SendAsync(requestMessage);
            Logger.LogInformation($"🟠 API Svarskod: {response.StatusCode}");

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<AIResponse>();
                aiResponse = result?.Choices?.FirstOrDefault()?.Message?.Content ?? "Ingen respons från AI.";
                Logger.LogInformation($"🟢 AI-svar: {aiResponse}");
            }
            else
            {
                aiResponse = $"❌ Fel vid API-anrop: {response.StatusCode}";
                Logger.LogError(aiResponse);
            }
        }
        catch (Exception ex)
        {
            aiResponse = $"🚨 Ett fel inträffade: {ex.Message}";
            Logger.LogError($"🚨 Exception: {ex}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    public class AIResponse
    {
        public List<Choice> Choices { get; set; }
    }

    public class Choice
    {
        public Message Message { get; set; }
    }

    public class Message
    {
        public string Content { get; set; }
    }
}
