
@page "/glossary/korean"
@rendermode InteractiveWebAssembly
@using System.Linq
@using System.Diagnostics

<HamburgerMenu />


<div class="container">
    <h3>Glosformulär - Koreanska</h3>

    <EditForm Model="userAnswerForm" OnValidSubmit="CheckAnswers" novalidate autocomplete="off">
        @foreach (var answer in userAnswerForm.Answers)
        {
            <div class="form-group">
                <label>@answer.Swedish</label>
                <InputText @bind-Value="answer.UserAnswer" class="form-control" autocomplete="off" />
                @if (showResult)
                {
                    if (string.IsNullOrWhiteSpace(answer.UserAnswer))
                    {
                        <span class="text-warning">⚠️ Detta fält är tomt.</span>
                    }
                    else if (NormalizeAnswer(answer.UserAnswer).Equals(NormalizeAnswer(answer.KoreanRomanized), StringComparison.OrdinalIgnoreCase))
                    {
                        <span class="text-success">✔️ Rätt!</span>
                    }
                    else
                    {
                        <span class="text-danger">❌ Fel, rätt svar är "@answer.KoreanRomanized".</span>
                    }
                }
            </div>
        }

        @if (showResult)
        {
            <div class="alert alert-info">
                Du fick @correctAnswers av @userAnswerForm.Answers.Count ord rätt!
                <br />
                ⏱️ Responstiden var @responseTime ms.
            </div>
        }

        @if (missingAnswers)
        {
            <div class="alert alert-warning">
                Du måste fylla i alla fält innan du kan kontrollera dina svar.
            </div>
        }
        @if (renderTime > 0)
        {
            <div class="alert alert-secondary mt-2">
                ⏱️ Renderingtiden var: @renderTime ms.
            </div>
        }

        <button type="submit" class="btn btn-primary">Rätta</button>
        <button type="button" class="btn btn-success mt-4" @onclick="ResetForm">Rensa glosformuläret</button>
    </EditForm>
</div>

@code {
    private UserAnswerForm userAnswerForm = new UserAnswerForm();
    private int correctAnswers = 0;
    private bool showResult = false;
    private bool missingAnswers = false;
    private long responseTime = 0;
    private bool firstRender = true;
    private Stopwatch renderStopwatch = new Stopwatch();
    private long renderTime;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            renderStopwatch.Stop();
            renderTime = renderStopwatch.ElapsedMilliseconds;

            Console.WriteLine($"⏱️ Renderingtiden (första render) var: {renderTime} ms.");
            StateHasChanged(); // Endast om du vill visa det i UI
        }
    }


    protected override void OnInitialized()
    {
        renderStopwatch.Start();
        userAnswerForm.Answers = new List<WordAnswer>
        {
            new WordAnswer("Hej", "안녕하세요", "annyeonghaseyo"),
            new WordAnswer("Tack", "감사합니다", "gamsahamnida"),
            new WordAnswer("Ja", "네", "ne"),
            new WordAnswer("Nej", "아니요", "aniyo"),
            new WordAnswer("Vatten", "물", "mul"),
            new WordAnswer("Mat", "음식", "eumsik"),
            new WordAnswer("Kärlek", "사랑", "sarang"),
            new WordAnswer("Vän", "친구", "chingu"),
            new WordAnswer("Familj", "가족", "gajok"),
            new WordAnswer("Skola", "학교", "hakgyo")
        };
    }

    private async Task CheckAnswers()
    {
        var stopwatch = Stopwatch.StartNew();

        missingAnswers = userAnswerForm.Answers.Any(answer => string.IsNullOrWhiteSpace(answer.UserAnswer));

        if (missingAnswers)
        {
            showResult = false;
            stopwatch.Stop();
            return;
        }

        correctAnswers = userAnswerForm.Answers.Count(answer =>
            NormalizeAnswer(answer.UserAnswer).Equals(NormalizeAnswer(answer.KoreanRomanized), StringComparison.OrdinalIgnoreCase));

        showResult = true;

        stopwatch.Stop();
        responseTime = stopwatch.ElapsedMilliseconds;

        await SaveAnswersToFunction();
    }

    [Inject] private HttpClient Http { get; set; }

    private async Task SaveAnswersToFunction()
    {
        var answersToSend = userAnswerForm.Answers.Select(a => new
        {
            swedish = a.Swedish,
            english = a.KoreanRomanized,
            userAnswer = a.UserAnswer,
            language = "korean"
        }).ToList();

        var response = await Http.PostAsJsonAsync("https://wordanswerfunctionapp.azurewebsites.net/api/SaveWordAnswers", answersToSend);

        if (!response.IsSuccessStatusCode)
        {
            Console.WriteLine($"❌ Error saving answers: {response.StatusCode}");
        }
        else
        {
            Console.WriteLine("✅ Answers saved to Azure Function.");
        }
    }


    private string NormalizeAnswer(string answer)
    {
        return string.Join(" ", answer?.Trim().Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries) ?? Array.Empty<string>());
    }

    private void ResetForm()
    {
        foreach (var answer in userAnswerForm.Answers)
        {
            answer.UserAnswer = string.Empty;
        }

        correctAnswers = 0;
        showResult = false;
        missingAnswers = false;
    }

    public class UserAnswerForm
    {
        public List<WordAnswer> Answers { get; set; } = new List<WordAnswer>();
    }

    public class WordAnswer
    {
        public string Swedish { get; set; }
        public string Korean { get; set; }
        public string KoreanRomanized { get; set; }
        public string UserAnswer { get; set; } = string.Empty;

        public WordAnswer(string swedish, string korean, string koreanRomanized)
        {
            Swedish = swedish;
            Korean = korean;
            KoreanRomanized = koreanRomanized;
        }
    }
}
